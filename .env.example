# Freight Copilot - Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# BACKEND CONFIGURATION (FastAPI)
# =============================================================================

# Dashboard authentication (admin login)
DASHBOARD_USER=admin
DASHBOARD_PASS=copilot2026!

# JWT Secret for token signing (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Backend URL for frontend proxy
BACKEND_URL=http://backend:8000

# =============================================================================
# FRONTEND CONFIGURATION (Vite + React)
# =============================================================================

# Frontend port
FRONTEND_PORT=3000

# Base path for deployment (use / for root, /app/ for subpath)
BASE_PATH=/

# API Base URL (used by frontend for API calls)
VITE_API_BASE_URL=/api

# Enable/disable mock mode for development
VITE_MOCK_MODE=false

# =============================================================================
# DATABASE (Optional - for future persistence)
# =============================================================================

# DATABASE_URL=postgresql://user:password@db:5432/freight_copilot

# =============================================================================
# REDIS (Optional - for SSE scaling across multiple backend instances)
# =============================================================================

# REDIS_URL=redis://redis:6379/0

# =============================================================================
# EMAIL SERVICE (Optional - for dispatch notifications)
# =============================================================================

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=dispatch@yourcompany.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Freight Copilot <dispatch@yourcompany.com>

# =============================================================================
# DAT BENCHMARK API (Optional - for live rate data)
# =============================================================================

# DAT_API_KEY=your-dat-api-key
# DAT_API_SECRET=your-dat-api-secret

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Sentry DSN (optional)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================

# Set to 'development' for hot reload, 'production' for production builds
NODE_ENV=production
PYTHON_ENV=production